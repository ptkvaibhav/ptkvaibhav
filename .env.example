# Copy to .env.local for local development. All variables are optional for
# browsing the site; the contact form needs Resend and Upstash. See docs/README.md.

# Canonical site URL (production: https://ptkvaibhav.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form: email delivery
RESEND_API_KEY=

# Contact form: rate limiting (required, the form fails closed without it)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: higher GitHub API rate limit for project/profile data (no scopes needed)
GITHUB_TOKEN=
